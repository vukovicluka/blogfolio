---
import websiteImage from "../../assets/website.webp";

interface Props {
  title?: string;
  description?: string;
}

const defaultTitle = "Luka Vuković";
const defaultDescription = "Software Engineering Blog and Portfolio";

const { title, description } = Astro.props;

const pageTitle = title ? `${title} | ${defaultTitle}` : defaultTitle;
const pageDescription = description || defaultDescription;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="Luka Vuković"
  href="/rss.xml"
/>
<link rel="canonical" href={canonicalUrl.href} />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="robots" content="index, follow" />

<!-- Web analytics -->
<!-- <script
  data-goatcounter="https://my-account.goatcounter.com/count"
  async
  src="//gc.zgo.at/count.js"></script> -->

<!-- Open Graph tags -->
<meta property="og:title" content={pageTitle} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:description" content={pageDescription} />
<meta
  property="og:image"
  content={new URL(websiteImage.src, Astro.site || Astro.url).href}
/>
<meta property="og:image:alt" content="Luka Vukovic's Blogfolio" />
<meta property="og:image:width" content="2454" />
<meta property="og:image:height" content="1060" />

<!-- Twitter/X card tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta
  name="twitter:image"
  content={new URL(websiteImage.src, Astro.site || Astro.url).href}
/>
<meta name="twitter:image:alt" content="Luka Vukovic's Blogfolio" />

<!-- Structured data -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Luka Vuković",
    url: Astro.site?.href,
    description: defaultDescription,
    author: {
      "@type": "Person",
      name: "Luka Vuković",
      url: Astro.site?.href,
      sameAs: [
        "https://www.linkedin.com/in/luka-vukovic/",
        "https://github.com/vukovicluka",
        "https://stackoverflow.com/users/16994268/vukovicluka",
      ],
    },
  })}
/>
