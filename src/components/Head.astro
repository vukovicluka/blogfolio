<!-- Open Graph tags -->
<meta
  property="og:title"
  content="Luka Vukovic's Blogfolio - Blog and Portfolio"
/>
<meta property="og:type" content="website" />
<meta property="og:url" content="https://lukavukovic.dev/" />
<meta
  property="og:description"
  content="Software Engineering Blog and Portfolio"
/>
<meta
  property="og:image"
  content={new URL(websiteImage.src, Astro.site || Astro.url).href}
/>
<meta property="og:image:alt" content="Luka Vukovic's Blogfolio" />
