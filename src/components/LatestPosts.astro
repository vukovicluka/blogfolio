---
import { getCollection, type CollectionEntry } from "astro:content";
import { calculateReadingTime } from "../utils/readingTime";

const allPosts: CollectionEntry<"blog">[] = await getCollection("blog");
const latestPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

<section id="latest-posts" aria-label="Latest blog posts">
  <div class="section-header animate">
    <h2 class="section-title">Latest posts</h2>
    <a href="/blog" class="view-all">View all →</a>
  </div>
  <div class="blog-list">
    {
      latestPosts.map((post, i) => (
        <article class={`blog-card animate animate-card-${i + 1}`}>
          <a href={`/blog/${post.slug}`}>
            <h3 class="post-title">{post.data.title}</h3>
            <div class="meta">
              <span class="date">
                {post.data.publishDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </span>
              <span class="dot">·</span>
              <span class="reading-time">
                {calculateReadingTime(post.body)}
              </span>
            </div>
            <p class="description">{post.data.description}</p>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="tags">
                {(post.data.tags as string[]).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </a>
        </article>
      ))
    }
  </div>
</section>

<style>
  #latest-posts {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-header {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
  }

  .section-title {
    font-family: "Fraunces", serif;
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
    color: #111;
  }

  .view-all {
    font-size: 0.9rem;
    font-weight: 600;
    color: #7c3aed;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .view-all:hover {
    color: #6d28d9;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .blog-card {
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 12px;
    padding: 1.5rem;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
    background: #fff;
  }

  .blog-card:hover {
    border-color: #7c3aed;
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.1);
    transform: translateY(-2px);
  }

  .blog-card a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
    color: #111;
    transition: color 0.2s ease;
    line-height: 1.3;
  }

  .blog-card:hover .post-title {
    color: #7c3aed;
  }

  .meta {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }

  .date,
  .reading-time {
    font-size: 0.875rem;
    color: rgba(0, 0, 0, 0.5);
  }

  .dot {
    font-size: 0.875rem;
    color: rgba(0, 0, 0, 0.3);
  }

  .description {
    font-size: 0.975rem;
    line-height: 1.6;
    color: rgba(0, 0, 0, 0.65);
    margin: 0;
  }

  .tags {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    display: inline-block;
    font-size: 0.8rem;
    padding: 0.2rem 0.65rem;
    background: rgba(124, 58, 237, 0.08);
    color: #7c3aed;
    border-radius: 99px;
    font-weight: 500;
  }

  .animate {
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  .section-header {
    animation-delay: 0.7s;
  }
  .animate-card-1 {
    animation-delay: 0.85s;
  }
  .animate-card-2 {
    animation-delay: 1s;
  }
  .animate-card-3 {
    animation-delay: 1.15s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .blog-card {
      padding: 1.25rem;
    }

    .post-title {
      font-size: 1.1rem;
    }
  }
</style>
