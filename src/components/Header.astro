---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

function isActive(href: string, path: string): boolean {
  if (href === "/") return path === "/";
  return path.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="site-name" href="/">Luka Vuković</a>

    <button
      class="menu-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-menu"
      type="button"
    >
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
    </button>

    <nav id="nav-menu" class="site-nav" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "site-nav__link",
              { active: isActive(link.href, currentPath) },
            ]}
            aria-current={isActive(link.href, currentPath) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/cv"
        target="_blank"
        rel="noopener noreferrer"
        class="cv-link"
      >
        CV
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </nav>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector(".menu-toggle");
    const nav = document.querySelector("#nav-menu");

    if (toggle && nav) {
      toggle.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!isOpen));
        nav.classList.toggle("open");
      });

      nav.querySelectorAll(".site-nav__link").forEach((link) => {
        link.addEventListener("click", () => {
          toggle.setAttribute("aria-expanded", "false");
          nav.classList.remove("open");
        });
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && nav.classList.contains("open")) {
          toggle.setAttribute("aria-expanded", "false");
          nav.classList.remove("open");
          (toggle as HTMLElement).focus();
        }
      });
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem clamp(1rem, 5vw, 4rem);
  }

  .site-name {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #111;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-name:hover,
  .site-name:focus-visible {
    color: #7c3aed;
  }

  .site-nav {
    display: flex;
    gap: 1.75rem;
  }

  .site-nav__link {
    position: relative;
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #111;
    text-decoration: none;
    padding: 0.25rem 0;
    transition: color 0.2s ease;
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    color: #7c3aed;
  }

  .site-nav__link.active {
    color: #7c3aed;
  }

  .site-nav__link.active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #7c3aed;
    border-radius: 999px;
  }

  .cv-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: #7c3aed;
    border: 1.5px solid #7c3aed;
    border-radius: 6px;
    padding: 0.3rem 0.7rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .cv-link:hover,
  .cv-link:focus-visible {
    background-color: #7c3aed;
    color: #fff;
  }

  .cv-link svg {
    flex-shrink: 0;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.4rem;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: 6px;
    transition: background-color 0.2s ease;
  }

  .menu-toggle:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .menu-toggle:focus-visible {
    outline: 2px solid #7c3aed;
    outline-offset: 2px;
  }

  .menu-toggle__bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #111;
    border-radius: 999px;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-wrap: wrap;
      min-width: 0;
    }

    .menu-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      flex-direction: column;
      width: 100%;
      gap: 0;
      padding: 0.5rem 0 1rem;
    }

    .site-nav.open {
      display: flex;
    }

    .site-nav__link {
      padding: 0.75rem 0;
      font-size: 0.95rem;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .site-nav__link:last-child {
      border-bottom: none;
    }

    .cv-link {
      margin-top: 0.5rem;
      width: fit-content;
    }

    .site-nav__link.active::after {
      display: none;
    }

    .site-nav__link.active {
      color: #7c3aed;
      font-weight: 600;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle__bar {
      transition: none;
    }
  }
</style>
