---
import { SOCIAL_LINKS } from "../config";
---

<footer class="global-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <a class="footer-name" href="/">Luka Vuković</a>
      <nav class="social-links" aria-label="Social media links">
        <a href={SOCIAL_LINKS.linkedin} aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" role="presentation">
            <path
              d="M19 0H5C2.24 0 0 2.24 0 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5V5c0-2.76-2.24-5-5-5zM7 19H4V9h3zm-1.5-11C4.67 8 4 7.33 4 6.5S4.67 5 5.5 5 7 5.67 7 6.5 6.33 8 5.5 8zM20 19h-3v-5.2c0-1.24-.02-2.8-1.7-2.8-1.7 0-1.96 1.33-1.96 2.7V19h-3V9h2.88v1.37h.04c.4-.76 1.38-1.56 2.85-1.56 3.05 0 3.62 2.01 3.62 4.63z"
            ></path>
          </svg>
        </a>
        <a href={SOCIAL_LINKS.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" role="presentation">
            <path
              d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.78 8.2 11.38.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.07-3.34.73-4.04-1.61-4.04-1.61-.55-1.38-1.35-1.74-1.35-1.74-1.1-.75.08-.74.08-.74 1.21.08 1.85 1.25 1.85 1.25 1.08 1.86 2.83 1.32 3.53 1.01.11-.79.42-1.32.76-1.63-2.67-.3-5.47-1.34-5.47-5.97 0-1.32.47-2.39 1.24-3.24-.13-.3-.54-1.51.12-3.15 0 0 1.01-.32 3.31 1.23a11.5 11.5 0 0 1 6.02 0c2.3-1.55 3.31-1.23 3.31-1.23.66 1.64.25 2.85.12 3.15.77.85 1.24 1.92 1.24 3.24 0 4.64-2.8 5.66-5.48 5.96.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.29 0 .32.22.69.83.57 4.76-1.6 8.2-6.08 8.2-11.38C24 5.37 18.63 0 12 0z"
            ></path>
          </svg>
        </a>
        <a
          href={SOCIAL_LINKS.stackoverflow}
          aria-label="Stack Overflow"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" role="presentation">
            <path
              d="M18.986 21.865v-6.404h2.134V24H1.844v-8.539h2.13v6.404h15.012zM6.111 19.731H16.85v-2.137H6.111v2.137zm.259-4.852l10.48 2.189.451-2.07-10.478-2.187-.453 2.068zm1.359-5.056l9.705 4.53.903-1.95-9.706-4.53-.902 1.936v.014zm2.715-4.785l8.217 6.855 1.359-1.62-8.216-6.853-1.35 1.617-.01.001zM15.751 0l-1.746 1.294 6.405 8.604 1.746-1.294L15.749 0h.002z"
            ></path>
          </svg>
        </a>
      </nav>
    </div>
    <div class="footer-divider"></div>
    <p class="copyright">&copy; 2026 Luka Vuković. All rights reserved.</p>
  </div>
</footer>

<style>
  .global-footer {
    flex-shrink: 0;
    padding: 2.5rem clamp(1rem, 5vw, 4rem) 2rem;
    background-color: #fff;
    color: #111;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .footer-inner {
    width: min(100%, 1100px);
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .footer-name {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #111;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-name:hover,
  .footer-name:focus-visible {
    color: #7c3aed;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(17, 17, 17, 0.55);
    text-decoration: none;
    padding: 0.4rem;
    border-radius: 8px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .social-links a:hover {
    color: #7c3aed;
    background-color: rgba(124, 58, 237, 0.08);
  }

  .social-links a:focus-visible {
    outline: 2px solid #7c3aed;
    outline-offset: 2px;
  }

  .social-links a svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }

  .footer-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(0, 0, 0, 0.06);
  }

  .copyright {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(17, 17, 17, 0.45);
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .footer-top {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
