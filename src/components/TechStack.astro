---
interface Technology {
  name: string;
  icon: string;
}

const technologies: Technology[] = [
  { name: "React", icon: "devicon-react-original" },
  { name: "Vue.js", icon: "devicon-vuejs-plain" },
  { name: "Next.js", icon: "devicon-nextjs-plain" },
  { name: "Node.js", icon: "devicon-nodejs-plain" },
  { name: "Nest.js", icon: "devicon-nestjs-original" },
  { name: "PostgreSQL", icon: "devicon-postgresql-plain" },
  { name: "Docker", icon: "devicon-docker-plain" },
  { name: "AWS", icon: "devicon-amazonwebservices-plain-wordmark" },
  { name: "Azure", icon: "devicon-azure-plain" },
  { name: "React Native", icon: "devicon-react-original" },
  { name: "Flutter", icon: "devicon-flutter-plain" },
];
---

<div class="tech-stack">
  <h2>Tech stack</h2>
  <p>
    Technologies and tools I feel most confident working with. As technologies
    change, tools come and go, I'm more focused on programming concepts and
    system design methodologies.
  </p>
  <br />
  <div class="tech-grid">
    {
      technologies.map((tech) => (
        <div class="tech-item" title={tech.name}>
          <i class={`${tech.icon} tech-icon`} />
          <span class="tech-name">{tech.name}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .tech-stack {
    margin-top: 3rem;
  }

  .tech-stack h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: #111;
    font-weight: 600;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1.5rem;
  }

  .tech-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem;
    border-radius: 8px;
    background-color: #f9fafb;
    transition: all 0.2s ease;
    cursor: default;
  }

  .tech-item:hover {
    background-color: #f3f4f6;
    transform: translateY(-2px);
  }

  .tech-icon {
    font-size: 3rem;
    color: #111;
  }

  .tech-name {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.75);
    text-align: center;
  }

  @media (max-width: 768px) {
    .tech-grid {
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 1rem;
    }

    .tech-item {
      padding: 1rem;
    }

    .tech-icon {
      font-size: 2.5rem;
    }

    .tech-name {
      font-size: 0.8rem;
    }
  }
</style>
